{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // BOTH platform surfaces, because this one config also drives ts-jest and
    // the suite covers the edge (Node) and the client (DOM). It is deliberately
    // NOT the fence: `tsconfig.client.json`, which actually emits the browser
    // bundle, sets `types: []` so a client file reaching for `process` or
    // `Buffer` fails the build. Same split as @estate/vault-crypto, for the
    // same reason — a permissive config for tests, a strict one for the
    // artifact that ships.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "jest"],
    // The client's absolute-path import of vault-crypto, resolved for the
    // editor and ts-jest. See tsconfig.client.json for why it maps to `dist`.
    "paths": {
      "/lib/vault-crypto/index.js": ["../../packages/vault-crypto/dist/index.d.ts"]
    }
  },
  "include": ["src", "test", "jest.config.js"]
}
