{
  "name": "@estate/service-vault",
  "version": "0.0.1",
  "private": true,
  "description": "Vault service (Zone A, docs/01 §2.5): SRP-authenticated vault open and opaque client-encrypted item storage. Stores ciphertext and verifiers only - no DEKs, no KMS, nothing this service can decrypt. Owns the vault cluster (docs/02 §5).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "dev": "node dist/main.js"
  },
  "dependencies": {
    "@estate/audit-emitter": "workspace:*",
    "@estate/auth-guard": "workspace:*",
    "@estate/authz": "workspace:*",
    "@estate/contracts": "workspace:*",
    "@estate/db": "workspace:*",
    "@estate/kafka": "workspace:*",
    "@estate/notifications-client": "workspace:*",
    "@estate/settlement-client": "workspace:*",
    "@estate/vault-crypto": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@estate/config": "workspace:*",
    "@nestjs/testing": "catalog:",
