{
  "name": "@estate/service-settlement",
  "version": "0.0.1",
  "private": true,
  "description": "Settlement service: death-verification intake, the case state machine with mandatory human review and waiting periods, the cross-service account lock, and (PR2) staged executor access and distribution tracking. Co-tenant of the core cluster with disjoint tables (docs/01 §2.7, docs/02 §7, docs/03 §5.1). PR1 stores no ciphertext — cases carry IDs, enums, and timestamps only.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "dev": "node dist/main.js",
    "operators": "node dist/operator-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "catalog:",
    "@estate/audit-emitter": "workspace:*",
    "@estate/auth-guard": "workspace:*",
    "@estate/authz": "workspace:*",
    "@estate/contracts": "workspace:*",
    "@estate/crypto": "workspace:*",
    "@estate/db": "workspace:*",
    "@estate/kafka": "workspace:*",
    "@estate/kms-aws": "workspace:*",
    "@estate/notifications-client": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@estate/config": "workspace:*",
    "@estate/service-profile": "workspace:*",
    "@nestjs/testing": "catalog:",
