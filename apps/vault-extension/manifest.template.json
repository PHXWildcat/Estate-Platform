{
  "manifest_version": 3,
  "name": "Estate Vault",
  "version": "0.0.1",
  "description": "Look up items in your Estate vault. Your vault password and Secret Key never leave this device.",
  "permissions": ["storage", "offscreen", "activeTab", "scripting"],
  "host_permissions": ["__VAULT_ORIGIN__/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Estate Vault",
    "default_popup": "popup.html"
  }
}
