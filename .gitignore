node_modules/
dist/
.next/
coverage/
.turbo/
*.tsbuildinfo

# env files never committed; use .env.example as the template
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db

# Generated AWS-endpoint TLS material for the local stack (production profile).
.stack-certs/

# The vault origin's compiled browser bundle (tsconfig.client.json). Emitted
# under public/ because that is what the edge serves, but build output all the
# same — the served tree is reproduced by `pnpm --filter @estate/vault-web build`.
apps/vault-web/public/app/

# The operator origin's compiled browser bundle (tsconfig.client.json), for the
# same reason: emitted under public/ because that is what the edge serves, and
# reproduced by `pnpm --filter @estate/operator-web build`.
apps/operator-web/public/app/

# The vault-crypto BROWSER build (tsconfig.esm.json). Build output like dist/,
# emitted separately because the browser loads native ES modules.
dist-esm/

# vault-crypto's browser build, copied in by apps/vault-web's build step.
apps/vault-web/public/lib/
# Agent review worktrees (CLAUDE.md's fan-out). Tracked only by
# `.git/info/exclude` until now, which is per-clone: on any other machine these
# show up as untracked, which is the last thing wanted beside a rule that says
# never `git add -A` while an agent is running against the tree.
.claude/worktrees/
